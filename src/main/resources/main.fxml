<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<BorderPane xmlns="http://javafx.com/javafx"
  xmlns:fx="http://javafx.com/fxml"
  fx:controller="edu.cnm.deepdive.helloworld.controller.MainController"
  prefHeight="400.0" prefWidth="600.0">

  <center>
    <Text fx:id="counter" text="0"/>
  </center>

  <left>
    <Button text="Decrement" onAction="#decrementCounter"/>
  </left>

  <right>
    <Button text="Increment" onAction="#incrementCounter"/>
  </right>

  <bottom>
    <Button text ="Reset" onAction="#resetCounter"/>
  </bottom>

</BorderPane>
